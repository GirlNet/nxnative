"            for (j = 0; j < 4; ++j) {\n"
"                endpoints[i][j] <<= 1;\n"
"            }\n"
"        }\n"
"\n"
"        if (mode == 1) {\n"
"            i = bcd7_bitstream_read_bit(&bstream);\n"
"            j = bcd7_bitstream_read_bit(&bstream);\n"
"\n"
"            for (k = 0; k < 3; ++k) {\n"
"                endpoints[0][k] |= i;\n"
"                endpoints[1][k] |= i;\n"
"                endpoints[2][k] |= j;\n"
"                endpoints[3][k] |= j;\n"
"            }\n"
"        } else if (sModeHasPBits & (1 << mode)) {\n"
"            \n"
"            for (i = 0; i < numEndpoints; ++i) {\n"
"                j = bcd7_bitstream_read_bit(&bstream);\n"
"                for (k = 0; k < 4; ++k) {\n"
"                    endpoints[i][k] |= j;\n"
"                }\n"
"            }\n"
"        }\n"
"    }\n"
"\n"
"    for (i = 0; i < numEndpoints; ++i) {\n"
"        \n"
"        j = actual_bits_count[0][mode] + ((sModeHasPBits >> mode) & 1);\n"
"\n"
"        for (k = 0; k < 3; ++k) {\n"
"            \n"
"            endpoints[i][k] = endpoints[i][k] << (8 - j);\n"
"            \n"
"            endpoints[i][k] = endpoints[i][k] | (endpoints[i][k] >> j);\n"
"        }\n"
"\n"
"        j = actual_bits_count[1][mode] + ((sModeHasPBits >> mode) & 1);\n"
"\n"
"        endpoints[i][3] = endpoints[i][3] << (8 - j);\n"
"        \n"
"        endpoints[i][3] = endpoints[i][3] | (endpoints[i][3] >> j);\n"
"    }\n"
"\n"
"    if (!actual_bits_count[1][mode]) {\n"
"        for (j = 0; j < numEndpoints; ++j) {\n"
"            endpoints[j][3] = 0xFF;\n"
"        }\n"
"    }\n"
"\n"
"    indexBits = (mode == 0 || mode == 1) ? 3 : ((mode == 6) ? 4 : 2);\n"
"    indexBits2 = (mode == 4) ? 3 : ((mode == 5) ? 2 : 0);\n"
"    weights = (indexBits == 2) ? aWeight2 : ((indexBits == 3) ? aWeight3 : aWeight4);\n"
"    weights2 = (indexBits2 == 2) ? aWeight2 : aWeight3;\n"
"\n"
"    for (i = 0; i < 4; ++i) {\n"
"        for (j = 0; j < 4; ++j) {\n"
"            partitionSet = (numPartitions == 1) ? ((i | j) ? 0 : 128) : partition_sets[numPartitions - 2][partition][i][j];\n"
"\n"
"            indexBits = (mode == 0 || mode == 1) ? 3 : ((mode == 6) ? 4 : 2);\n"
"\n"
"            if (partitionSet & 0x80) {\n"
"                indexBits--;\n"
"            }\n"
"\n"
"            indices[i][j] = bcd7_bitstream_read_bits(&bstream, indexBits);\n"
"        }\n"
"    }\n"
"\n"
"    for (i = 0; i < 4; ++i) {\n"
"        for (j = 0; j < 4; ++j) {\n"
"            partitionSet = (numPartitions == 1) ? ((i|j) ? 0 : 128) : partition_sets[numPartitions - 2][partition][i][j];\n"
"            partitionSet &= 0x03;\n"
"\n"
"            index = indices[i][j];\n"
"\n"
"            if (!indexBits2) {\n"
"                r = bcd7_interpolate(endpoints[partitionSet * 2][0], endpoints[partitionSet * 2 + 1][0], weights, index);\n"
"                g = bcd7_interpolate(endpoints[partitionSet * 2][1], endpoints[partitionSet * 2 + 1][1], weights, index);\n"
"                b = bcd7_interpolate(endpoints[partitionSet * 2][2], endpoints[partitionSet * 2 + 1][2], weights, index);\n"
"                a = bcd7_interpolate(endpoints[partitionSet * 2][3], endpoints[partitionSet * 2 + 1][3], weights, index);\n"
"            } else {\n"
"                index2 = bcd7_bitstream_read_bits(&bstream, (i|j) ? indexBits2 : (indexBits2 - 1));\n"
"                \n"
"                if (!indexSelectionBit) {\n"
"                    r = bcd7_interpolate(endpoints[partitionSet * 2][0], endpoints[partitionSet * 2 + 1][0],  weights,  index);\n"
"                    g = bcd7_interpolate(endpoints[partitionSet * 2][1], endpoints[partitionSet * 2 + 1][1],  weights,  index);\n"
"                    b = bcd7_interpolate(endpoints[partitionSet * 2][2], endpoints[partitionSet * 2 + 1][2],  weights,  index);\n"
"                    a = bcd7_interpolate(endpoints[partitionSet * 2][3], endpoints[partitionSet * 2 + 1][3], weights2, index2);\n"
"                } else {\n"
"                    r = bcd7_interpolate(endpoints[partitionSet * 2][0], endpoints[partitionSet * 2 + 1][0], weights2, index2);\n"
"                    g = bcd7_interpolate(endpoints[partitionSet * 2][1], endpoints[partitionSet * 2 + 1][1], weights2, index2);\n"
"                    b = bcd7_interpolate(endpoints[partitionSet * 2][2], endpoints[partitionSet * 2 + 1][2], weights2, index2);\n"
"                    a = bcd7_interpolate(endpoints[partitionSet * 2][3], endpoints[partitionSet * 2 + 1][3],  weights,  index);\n"
"                }\n"
"            }\n"
"\n"
"            switch (rotation) {\n"
"                case 1: {   \n"
"                    bcd7_swap_values(&a, &r);\n"
"                } break;\n"
"                case 2: {   \n"
"                    bcd7_swap_values(&a, &g);\n"
"                } break;\n"
"                case 3: {   \n"
"                    bcd7_swap_values(&a, &b);\n"
"                } break;\n"
"            }\n"
"\n"
"            decompressed[j * 4 + 0] = r;\n"
"            decompressed[j * 4 + 1] = g;\n"
"            decompressed[j * 4 + 2] = b;\n"
"            decompressed[j * 4 + 3] = a;\n"
"        }\n"
"\n"
"        decompressed += destinationPitch;\n"
"    }\n"
"}\n"
